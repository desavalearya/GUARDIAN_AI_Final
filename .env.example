# Copy to .env — never commit real secrets.

# Postgres
POSTGRES_USER=guardian
POSTGRES_PASSWORD=guardian
POSTGRES_DB=guardian
DATABASE_URL=postgresql+psycopg://guardian:guardian@postgres:5432/guardian

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# JWT (auth only — do not reuse for vault/HMAC)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Dedicated privacy secrets (independent of JWT)
HMAC_SECRET=change-me-hmac-secret-not-jwt
VAULT_SECRET=change-me-vault-secret-not-jwt

# CORS (comma-separated). Add LAN / deployed origins for remote demos.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# App
APP_NAME=PhishProof
MODEL_DIR=/app/models
DATA_DIR=/app/data
INGEST_API_KEY=change-me-ingest-key

MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com
DKIM_SELECTOR=guardian
POSTFIX_HOST=postfix
POSTFIX_SUBMISSION_PORT=587
RELAYHOST=
RELAY_USER=
RELAY_PASSWORD=

# Two-server demo: gateway routes this domain to the downstream Mailpit SMTP server.
DEMO_RECEIVER_DOMAIN=company-b.test
DEMO_RECEIVER_HOST=receiver
DEMO_RECEIVER_PORT=1025
MAILPIT_URL=http://receiver:8025
DEMO_RECEIVER_ADDRESS=receiver@company-b.test

# Adaptive inference (keeps SMTP fast; deep models run inline only when needed).
ANALYSIS_MODE=adaptive
DEEP_SYNC_MIN_RISK=15
DEEP_SYNC_MAX_RISK=90
ASYNC_DEEP_ENABLED=true
URL_CACHE_TTL_SECONDS=86400
SMTP_SCAN_TIMEOUT_SECONDS=20

# Optional enterprise integrations. Empty SIEM URL keeps delivery disabled.
SIEM_WEBHOOK_URL=
SIEM_HMAC_SECRET=change-me-siem-secret
SIEM_TIMEOUT_SECONDS=5
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Attachment security (falls back safely if ClamAV/YARA are unavailable).
CLAMAV_ENABLED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5
YARA_RULES_PATH=/app/data/yara

# Click-time URL protection.
URL_REWRITE_ENABLED=true
URL_REWRITE_SECRET=change-me-url-rewrite-secret
PUBLIC_API_URL=http://localhost:8000
URL_REWRITE_TTL_SECONDS=604800

# Enterprise tenancy / SSO / mail-provider connectors (inactive until credentials are supplied).
DEFAULT_ORG_SLUG=default
CONNECTOR_WEBHOOK_SECRET=change-me-connector-secret
M365_TENANT_ID=
M365_CLIENT_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
